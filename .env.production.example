# Khanya POS production environment
# Copy to .env on the VPS and replace every CHANGE_THIS_* value before startup.

APP_ENV=production
APP_NAME=Khanya POS API
API_HOST=0.0.0.0
API_PORT=8009

# Published application image
# Use latest for normal deployments, or pin to sha-<shortsha> for rollback.
KHANYA_IMAGE_TAG=latest

# Loopback-only host port for local VPS health checks.
# The shared Caddy edge talks to khanya-api:8009 over public-edge.
KHANYA_API_HOST_PORT=18009

# Database
POSTGRES_DB=khanya
POSTGRES_USER=khanya
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://khanya:CHANGE_THIS_DATABASE_PASSWORD@db:5432/khanya

# Redis
REDIS_URL=redis://redis:6379/0

# Authentication security
JWT_SECRET=CHANGE_THIS_LONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Native Flutter clients do not require browser CORS. Add explicit web origins
# here later if a browser client is introduced.
CORS_ORIGINS=

# Private object storage. MinIO is intentionally not published to the internet.
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=khanya
OBJECT_STORAGE_SECRET_KEY=CHANGE_THIS_LONG_MINIO_SECRET
OBJECT_STORAGE_BUCKET=khanya-documents
OBJECT_STORAGE_REGION=us-east-1
MAX_RECEIPT_UPLOAD_BYTES=15728640
